# Interactive development VM (QEMU, user networking with internet access).
#
#   nix run .#vm
#
# Then open https://openitcockpit.localhost:8443 (self-signed certificate,
# user@example.org / asdf12) or `ssh -p 2222 root@localhost` (password: root).
# The first start pulls ~6 GB of images and runs the openITCOCKPIT setup,
# watch it with `journalctl -fu podman-openitcockpit-openitcockpit`.
#
# The VM disk is ./oitc.qcow2 in the current directory (override with
# NIX_DISK_IMAGE=/path/oitc.qcow2); delete it to start from scratch.
{
  self,
  nixpkgs,
  pkgs,
}:
let
  domain = "openitcockpit.localhost";

  cert = pkgs.runCommand "dev-cert" { nativeBuildInputs = [ pkgs.openssl ]; } ''
    mkdir $out
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj /CN=${domain} \
      -addext subjectAltName=DNS:${domain} \
      -keyout $out/key.pem -out $out/cert.pem
  '';
in
nixpkgs.lib.nixosSystem {
  inherit (pkgs.stdenv.hostPlatform) system;
  modules = [
    self.nixosModules.default
    "${nixpkgs}/nixos/modules/virtualisation/qemu-vm.nix"
    (
      { lib, pkgs, ... }:
      {
        system.stateVersion = "26.05";
        networking.hostName = "oitc";

        virtualisation = {
          memorySize = 6144;
          cores = 4;
          diskSize = 40 * 1024;
          graphics = false;
          forwardPorts = [
            {
              from = "host";
              host.port = 8443;
              guest.port = 443;
            }
            {
              from = "host";
              host.port = 2222;
              guest.port = 22;
            }
          ];
        };

        # Development only!
        users.users.root.password = "root";
        services.getty.autologinUser = "root";
        services.openssh = {
          enable = true;
          settings.PermitRootLogin = "yes";
        };
        networking.firewall.allowedTCPPorts = [ 22 ];

        environment.systemPackages = with pkgs; [
          htop
          curl
          jq
        ];

        services.openitcockpit = {
          enable = true;
          nginx = {
            enable = true;
            inherit domain;
            enableACME = false;
            openFirewall = true;
          };
          customImage.commands = [
            # Workaround for an upstream bug on fresh installs, see README.
            ''sed -i 's|mysqladmin --defaults-extra-file="$INIFILE" ping|mysqladmin --defaults-extra-file="$DUMPINIFILE" ping|' /opt/openitc/frontend/CONTAINER_SETUP.sh''
            # Try e.g.:
            # "apt-get update && apt-get -y upgrade && apt-get clean"
          ];
          # autoUpdate.enable = true;
        };

        services.nginx.virtualHosts.${domain} = {
          sslCertificate = "${cert}/cert.pem";
          sslCertificateKey = "${cert}/key.pem";
          # The browser talks to host port 8443, keep it in the Host header so
          # redirects generated by openITCOCKPIT point to the forwarded port.
          locations."/".recommendedProxySettings = lib.mkForce false;
          locations."/".extraConfig = ''
            proxy_set_header Host $host:8443;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
          '';
        };
      }
    )
  ];
}
