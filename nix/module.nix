{
  config,
  lib,
  pkgs,
  ...
}:

let
  inherit (lib)
    mkOption
    mkEnableOption
    mkIf
    mkMerge
    mkDefault
    types
    literalExpression
    concatMap
    concatMapStrings
    concatStringsSep
    mapAttrsToList
    filterAttrs
    listToAttrs
    nameValuePair
    optional
    optionals
    optionalString
    escapeShellArg
    escapeShellArgs
    hasPrefix
    hasInfix
    unique
    genList
    head
    splitString
    ;

  cfg = config.services.openitcockpit;

  defs = import ./containers.nix;

  podman = config.virtualisation.podman.package;
  uid = toString cfg.uid;

  # Container names and with them the systemd units are prefixed to avoid
  # clashes with other oci-containers on the host (e.g. a second "redis").
  namePrefix = "openitcockpit-";
  unitName = instance: "podman-${namePrefix}${instance}";

  setupUnit = "openitcockpit-podman-setup";
  pullUnit = "openitcockpit-image-pull";
  buildUnit = "openitcockpit-image-build";
  updateUnit = "openitcockpit-update";

  imageRef = c: if hasPrefix "sha256:" c.tag then "${c.image}@${c.tag}" else "${c.image}:${c.tag}";

  ##########################################################################
  # Instances (some compose services are scaled to several containers)
  ##########################################################################

  instancesOf =
    service: def:
    if (def.instances or null) == "carbon" then
      genList (
        i:
        let
          n = toString (i + 1);
        in
        {
          name = "carbon-cache${n}";
          hostname = "carbon-cache${n}";
          environment.CC_INSTANCE = n;
        }
      ) cfg.carbonCacheInstances
    else if (def.instances or null) == "gearman" then
      if cfg.modGearmanWorkerReplicas == 1 then
        [ { name = service; } ]
      else
        genList (i: { name = "${service}-${toString (i + 1)}"; }) cfg.modGearmanWorkerReplicas
    else
      [ { name = service; } ];

  enabledServices = filterAttrs (n: _: cfg.containers.${n}.enable) defs;

  # instance name -> { service, def, opts, inst }
  instances = listToAttrs (
    concatMap (
      service:
      map (
        inst:
        nameValuePair inst.name {
          inherit service inst;
          inherit (inst) name;
          def = defs.${service};
          opts = cfg.containers.${service};
        }
      ) (instancesOf service defs.${service})
    ) (builtins.attrNames enabledServices)
  );

  volumeName = v: head (splitString ":" v);
  namedVolumes = unique (
    builtins.filter (v: !(hasPrefix "/" v)) (
      concatMap (i: map volumeName ((i.def.volumes or [ ]) ++ i.opts.extraVolumes)) (
        builtins.attrValues instances
      )
    )
  );

  ##########################################################################
  # openitcockpit.env
  ##########################################################################

  defaultEnvironment = {
    # Values of the upstream openitcockpit.env
    MYSQL_ROOT_PASSWORD = "root_password";
    MYSQL_DATABASE = "openitcockpit";
    MYSQL_USER = "openitcockpit";
    MYSQL_PASSWORD = "openitcockpit_password";
    OITC_ADMIN_EMAIL = "user@example.org";
    OITC_ADMIN_PASSWORD = "asdf12";
    OITC_ADMIN_FIRSTNAME = "John";
    OITC_ADMIN_LASTNAME = "Doe";
    OITC_GRAFANA_ADMIN_PASSWORD = "bGsPMxURCjg4esgJ";
    GF_SECURITY_ADMIN_PASSWORD = "bGsPMxURCjg4esgJ";
  };

  setEnv = filterAttrs (_: v: v != null) cfg.environment;
  envOr = k: d: if setEnv ? ${k} then toString setEnv.${k} else d;

  # Some images read the MySQL credentials from differently named variables
  # (with the default password baked into the image). Derive them from MYSQL_*
  # so that changing MYSQL_PASSWORD in Nix is enough. Explicit values win.
  derivedEnvironment =
    let
      host = envOr "MYSQL_HOST" "mysql";
      port = envOr "MYSQL_PORT" "3306";
      user = envOr "MYSQL_USER" "openitcockpit";
      password = envOr "MYSQL_PASSWORD" "openitcockpit_password";
      database = envOr "MYSQL_DATABASE" "openitcockpit";
    in
    {
      # mod_gearman_worker
      OITC_MYSQL_HOST = host;
      OITC_MYSQL_PORT = port;
      OITC_MYSQL_USER = user;
      OITC_MYSQL_PASSWORD = password;
      OITC_MYSQL_DATABASE = database;
      # statusengine-worker
      STATUSENGINE_MYSQL_DSN = "${user}:${password}@tcp(${host}:${port})/${database}?parseTime=true";
    }
    // listToAttrs (
      genList (
        i: nameValuePair "CCR_CARBON_CACHE_${toString (i + 1)}" "carbon-cache${toString (i + 1)}:2003"
      ) cfg.carbonCacheInstances
    );

  finalEnvironment = derivedEnvironment // (lib.mapAttrs (_: toString) setEnv);

  envFileText = ''
    # Generated by the openITCOCKPIT NixOS module - do not edit.
    # Extend it with services.openitcockpit.{environment,extraEnv,environmentFiles}.
    ${concatStringsSep "\n" (mapAttrsToList (k: v: "${k}=${v}") finalEnvironment)}
  ''
  + optionalString (cfg.extraEnv != "") ''

    # services.openitcockpit.extraEnv
    ${cfg.extraEnv}
  '';

  envFile = pkgs.writeText "openitcockpit.env" envFileText;

  ##########################################################################
  # Custom (overlay) image for the openitcockpit container
  ##########################################################################

  custom = cfg.customImage;
  customEnabled = custom.commands != [ ] || custom.extraInstructions != "";
  oitcOpts = cfg.containers.openitcockpit;
  baseRef = imageRef oitcOpts;

  containerfileText = ''
    FROM ${baseRef}
    ${concatMapStrings (c: "RUN ${c}\n") custom.commands}
    ${custom.extraInstructions}
  '';
  buildContext = pkgs.writeTextDir "Containerfile" containerfileText;
  customRepo = "localhost/openitcockpit-ce-custom";
  # Content addressed tag: a config change produces a new tag, which changes the
  # container unit and makes NixOS rebuild + restart on switch.
  customTag = builtins.substring 0 16 (
    builtins.hashString "sha256" (containerfileText + toString oitcOpts.imageFile)
  );
  customRef = "${customRepo}:${customTag}";
  basePull = if oitcOpts.imageFile != null then "never" else "missing";

  ##########################################################################
  # Helpers
  ##########################################################################

  podmanWrapper = pkgs.writeShellScriptBin "openitcockpit-podman" ''
    # Run podman in the rootless context of the openITCOCKPIT user.
    cd ${escapeShellArg cfg.dataDir} 2>/dev/null || cd /
    if [ "$(id -u)" = ${uid} ]; then
      exec ${podman}/bin/podman "$@"
    fi
    if [ "$(id -u)" != 0 ]; then
      echo "openitcockpit-podman: must be run as root or as ${cfg.user}" >&2
      exit 1
    fi
    exec ${pkgs.util-linux}/bin/runuser -u ${escapeShellArg cfg.user} -- \
      ${pkgs.coreutils}/bin/env \
        HOME=${escapeShellArg cfg.dataDir} \
        XDG_RUNTIME_DIR=/run/user/${uid} \
        PATH=/run/wrappers/bin:${lib.makeBinPath [ podman ]}:$PATH \
      ${podman}/bin/podman "$@"
  '';

  # Instances whose container runs an image pulled from a registry (not an
  # imageFile, not the locally built custom image).
  registryInstances = filterAttrs (
    _: i: i.opts.imageFile == null && !(i.service == "openitcockpit" && customEnabled)
  ) instances;

  # image reference -> list of units, for images pulled from a registry
  updatable = filterAttrs (_: i: i.opts.autoUpdate) registryInstances;
  updateGroups = lib.groupBy' (acc: i: acc ++ [ "${unitName i.name}.service" ]) [ ] (
    i: imageRef i.opts
  ) (builtins.attrValues updatable);

  # Missing images are pulled one after another, with retries, before the
  # containers start. Otherwise every container unit pulls its own image when it
  # starts: concurrent pulls into the same rootless image store can fail while
  # writing shared layers, and systemd does not retry the start of containers
  # that failed with result 'dependency' (e.g. openitcockpit when redis failed).
  # Includes the base of the custom image, so the build does not pull either.
  pulledImages = unique (
    mapAttrsToList (_: i: imageRef i.opts) registryInstances
    ++ optional (customEnabled && instances ? openitcockpit && oitcOpts.imageFile == null) baseRef
  );

  # Seconds before the next attempt: 7 attempts per image within ~14 minutes.
  pullRetryDelays = [
    10
    30
    60
    120
    300
    300
  ];

  pullScript = ''
    failed=0

    pull() {
      local ref=$1 attempt=1 delay
      if podman image exists "$ref"; then
        echo "$ref is present"
        return 0
      fi
      for delay in ${concatStringsSep " " (map toString pullRetryDelays)} last; do
        echo "Pulling $ref (attempt $attempt)"
        if podman pull --quiet "$ref" >/dev/null; then
          return 0
        fi
        if [ "$delay" = last ]; then
          break
        fi
        echo "Pulling $ref failed, retrying in ''${delay}s" >&2
        sleep "$delay"
        attempt=$((attempt + 1))
      done
      echo "Giving up on $ref after $attempt attempts" >&2
      failed=1
    }

    for ref in ${escapeShellArgs pulledImages}; do
      pull "$ref"
    done
    exit "$failed"
  '';

  customBuildBasePull =
    if oitcOpts.autoUpdate && oitcOpts.imageFile == null then "always" else "never";

  minFree = cfg.autoUpdate.minFreeSpaceGiB;

  updateScript = ''
    set -uo pipefail
    failed=0
    restart=()

    ${optionalString (minFree > 0) ''
      # Refuse to start pulling/building when the image store is (nearly) full.
      storage=$(openitcockpit-podman info --format '{{.Store.GraphRoot}}' 2>/dev/null || true)
      if [ -z "$storage" ] || [ ! -d "$storage" ]; then
        storage=${escapeShellArg cfg.dataDir}
      fi
      available=$(df --output=avail -B1 "$storage" | tail -n 1 | tr -d ' ')
      required=$(( ${toString minFree} * 1024 * 1024 * 1024 ))
      if [ -z "$available" ] || [ "$available" -lt "$required" ]; then
        echo "Not enough free disk space for the update in $storage:" \
          "$(( ''${available:-0} / 1024 / 1024 / 1024 )) GiB available, ${toString minFree} GiB required. Aborting." >&2
        exit 1
      fi
      echo "Free disk space in $storage: $(( available / 1024 / 1024 / 1024 )) GiB (required: ${toString minFree} GiB)"
    ''}

    image_id() {
      openitcockpit-podman image inspect --format '{{.Id}}' "$1" 2>/dev/null || true
    }

    update_image() {
      local ref=$1 old new
      shift
      old=$(image_id "$ref")
      echo "Pulling $ref"
      if ! openitcockpit-podman pull --quiet "$ref" >/dev/null; then
        echo "Failed to pull $ref" >&2
        failed=1
        return 0
      fi
      new=$(image_id "$ref")
      if [ "$old" != "$new" ]; then
        echo "$ref changed: ''${old:0:12} -> ''${new:0:12}"
        restart+=("$@")
      else
        echo "$ref is up to date"
      fi
    }

    ${concatStringsSep "\n" (
      mapAttrsToList (ref: units: "update_image ${escapeShellArgs ([ ref ] ++ units)}") updateGroups
    )}

    ${optionalString (customEnabled && instances ? openitcockpit) ''
      old=$(image_id ${customRef})
      echo "Rebuilding ${customRef} (base pull policy: ${customBuildBasePull})"
      if openitcockpit-podman build --pull=${customBuildBasePull} --no-cache \
          --tag ${customRef} --file ${buildContext}/Containerfile ${buildContext}; then
        new=$(image_id ${customRef})
        if [ "$old" != "$new" ]; then
          restart+=(${unitName "openitcockpit"}.service)
        fi
      else
        echo "Failed to rebuild ${customRef}" >&2
        failed=1
      fi
    ''}

    if [ "''${#restart[@]}" -gt 0 ]; then
      echo "Restarting: ''${restart[*]}"
      systemctl try-restart "''${restart[@]}" || failed=1
    fi

    ${optionalString cfg.autoUpdate.pruneImages ''
      openitcockpit-podman image prune --force >/dev/null || true
    ''}

    exit "$failed"
  '';

  ##########################################################################
  # Option types
  ##########################################################################

  containerOptions = service: def: {
    options = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Whether to run the `${service}` container.";
      };

      image = mkOption {
        type = types.str;
        default = def.image;
        description = "Fully qualified image repository (without tag).";
      };

      tag = mkOption {
        type = types.str;
        default = def.tag or "latest";
        example = "sha256:84e17a2135694498ffccb5b58e48299fd6385083a5a135fc1abd0c62bd9d5ef9";
        description = ''
          Image tag. A value starting with `sha256:` is used as digest
          (`image@sha256:...`), which pins the image completely.
        '';
      };

      imageFile = mkOption {
        type = types.nullOr types.package;
        default = null;
        example = literalExpression ''
          pkgs.dockerTools.pullImage {
            imageName = "docker.io/library/redis";
            imageDigest = "sha256:...";
            hash = "sha256-...";
            finalImageTag = "latest";
          }
        '';
        description = ''
          Image archive built by Nix (e.g. `dockerTools.pullImage`) that is
          loaded instead of pulling from the registry. `image` and `tag` must
          match the name inside the archive. Containers using this are never
          touched by the update job.
        '';
      };

      autoUpdate = mkOption {
        type = types.bool;
        default = true;
        description = ''
          Whether `openitcockpit-update.service` (timer or manual run) pulls
          this image and restarts the container if it changed.
        '';
      };

      environment = mkOption {
        type = types.attrsOf types.str;
        default = { };
        description = "Additional environment variables only for this container.";
      };

      environmentFiles = mkOption {
        type = types.listOf types.path;
        default = [ ];
        description = "Additional environment files (read at runtime) only for this container.";
      };

      cmd = mkOption {
        type = types.nullOr (types.listOf types.str);
        default = null;
        description = "Override the container command (null keeps the module default).";
      };

      ports = mkOption {
        type = types.listOf types.str;
        default = [ ];
        example = [ "127.0.0.1:8091:8091" ];
        description = "Additional published ports (`podman run -p`).";
      };

      extraVolumes = mkOption {
        type = types.listOf types.str;
        default = [ ];
        description = "Additional volumes / bind mounts (`podman run -v`).";
      };

      extraOptions = mkOption {
        type = types.listOf types.str;
        default = [ ];
        description = "Additional `podman run` options.";
      };
    };
  };

in
{
  options.services.openitcockpit = {
    enable = mkEnableOption "openITCOCKPIT Community Edition (rootless podman containers)";

    user = mkOption {
      type = types.str;
      default = "openitcockpit";
      description = "System user that owns and runs the rootless podman containers.";
    };

    group = mkOption {
      type = types.str;
      default = "openitcockpit";
      description = "Primary group of {option}`services.openitcockpit.user`.";
    };

    uid = mkOption {
      type = types.int;
      default = 2930;
      description = ''
        Static UID of {option}`services.openitcockpit.user`. Rootless podman
        units depend on `/run/user/<uid>`, so the UID has to be known at
        evaluation time.
      '';
    };

    dataDir = mkOption {
      type = types.path;
      default = "/var/lib/openitcockpit";
      description = ''
        Home directory of the service user. Container images and named volumes
        live below `.local/share/containers/storage` in here.
      '';
    };

    networkName = mkOption {
      type = types.str;
      default = "oitc-backend";
      description = "Name of the podman network shared by all containers.";
    };

    listen = {
      address = mkOption {
        type = types.str;
        default = "127.0.0.1";
        description = ''
          Host address the HTTPS port of the openitcockpit container is published on.
          Keep it on loopback when using the nginx integration.
        '';
      };
      port = mkOption {
        type = types.port;
        default = 8443;
        description = ''
          Host port for the container's HTTPS endpoint (container port 443,
          self-signed certificate). The container's port 80 only redirects to
          HTTPS and is therefore not published.
        '';
      };
    };

    environment = mkOption {
      type = types.attrsOf (types.nullOr (types.either types.str types.int));
      default = { };
      example = {
        OITC_ADMIN_EMAIL = "admin@example.org";
        GW_TIMEZONE = "Europe/Berlin";
        OITC_DEBUG = null; # drop a key
      };
      description = ''
        Variables written to the generated `openitcockpit.env`, which is passed
        to every container that uses `env_file` in the upstream compose.yml.
        Defaults are the values of the upstream `openitcockpit.env`; set a key
        to `null` to remove it. Values are written verbatim (no quoting).

        `OITC_MYSQL_*` (mod_gearman_worker), `STATUSENGINE_MYSQL_DSN`
        (statusengine-worker) and `CCR_CARBON_CACHE_<n>` are derived
        automatically unless set explicitly here.

        Do not put secrets here, they end up in the world readable Nix store.
        Use {option}`services.openitcockpit.environmentFiles` instead.
      '';
    };

    extraEnv = mkOption {
      type = types.lines;
      default = "";
      example = ''
        GW_TIMEZONE=Europe/Berlin
        VICTORIA_METRICS_RETENTION_PERIOD=12
      '';
      description = ''
        Raw lines appended to the generated `openitcockpit.env`. Later
        definitions of a key win, so this can also override `environment`.
      '';
    };

    environmentFiles = mkOption {
      type = types.listOf types.path;
      default = [ ];
      example = literalExpression ''[ config.sops.templates."openitcockpit.env".path ]'';
      description = ''
        Environment files read at container start, after the generated
        `openitcockpit.env` (so they override it). Use this for secrets, e.g.
        a sops-nix or agenix managed file. Passed to all containers that use
        `env_file` upstream.
      '';
    };

    envFile = mkOption {
      type = types.path;
      readOnly = true;
      default = envFile;
      defaultText = literalExpression "<generated openitcockpit.env>";
      description = "The generated `openitcockpit.env` (read-only).";
    };

    carbonCacheInstances = mkOption {
      type = types.ints.between 2 10;
      default = 2;
      description = ''
        Number of carbon-cache containers (`carbon-cache1` .. `carbon-cacheN`).
        carbon-c-relay always falls back to `carbon-cache1` and
        `carbon-cache2`, hence the minimum of 2.
      '';
    };

    modGearmanWorkerReplicas = mkOption {
      type = types.ints.positive;
      default = 1;
      description = "Number of mod_gearman_worker containers (compose `deploy.replicas`).";
    };

    containers = mkOption {
      default = { };
      description = ''
        Per container settings. The attribute names are the compose service
        names; `carbon-cache` and `mod_gearman_worker` apply to all of their
        instances.
      '';
      type = types.submodule {
        options = lib.mapAttrs (
          service: def:
          mkOption {
            default = { };
            description = "Settings of the `${service}` container.";
            type = types.submodule (containerOptions service def);
          }
        ) defs;
      };
    };

    customImage = {
      commands = mkOption {
        type = types.listOf types.str;
        default = [ ];
        example = [ "apt-get update && apt-get -y upgrade && apt-get clean" ];
        description = ''
          If non-empty, the openitcockpit container does not run the upstream
          image directly but a locally built image `FROM` it, with one `RUN`
          instruction per entry. Useful to pull in e.g. security updates
          between upstream releases. The image is rebuilt (without layer cache)
          by `openitcockpit-update.service`.
        '';
      };

      extraInstructions = mkOption {
        type = types.lines;
        default = "";
        example = ''
          COPY --from=docker.io/library/busybox:latest /bin/busybox /usr/local/bin/busybox
        '';
        description = "Raw Containerfile instructions appended after `commands`.";
      };

      ref = mkOption {
        type = types.str;
        readOnly = true;
        default = customRef;
        description = "Reference of the locally built image (read-only).";
      };
    };

    autoUpdate = {
      enable = mkEnableOption ''
        a timer that periodically runs `openitcockpit-update.service`. The
        service pulls all images with `containers.<name>.autoUpdate = true`,
        rebuilds the custom image and restarts containers whose image changed.
        The service also exists without the timer and can be started manually
      '';

      interval = mkOption {
        type = types.str;
        default = "weekly";
        example = "Sun *-*-* 03:00:00";
        description = "systemd `OnCalendar` expression for the update timer.";
      };

      randomizedDelaySec = mkOption {
        type = types.str;
        default = "1h";
        description = "systemd `RandomizedDelaySec` for the update timer.";
      };

      pruneImages = mkOption {
        type = types.bool;
        default = true;
        description = "Remove dangling images after an update run.";
      };

      minFreeSpaceGiB = mkOption {
        type = types.ints.unsigned;
        default = 10;
        description = ''
          Minimum free disk space (GiB) on the filesystem of the podman image
          store (`podman info` GraphRoot, below
          {option}`services.openitcockpit.dataDir` by default).
          `openitcockpit-update.service` fails before pulling or building
          anything if less is available. `0` disables the check.
        '';
      };
    };

    nginx = {
      enable = mkEnableOption ''
        a virtual host in the host's nginx that proxies the given domain to the
        openitcockpit container (HTTPS with redirect, websockets included).
        Further settings can be added to
        `services.nginx.virtualHosts.<domain>` directly
      '';

      domain = mkOption {
        type = types.str;
        example = "monitoring.example.org";
        description = "Server name of the virtual host.";
      };

      enableACME = mkOption {
        type = types.bool;
        default = cfg.nginx.useACMEHost == null;
        defaultText = literalExpression "config.services.openitcockpit.nginx.useACMEHost == null";
        description = "Obtain a certificate for {option}`services.openitcockpit.nginx.domain` via `security.acme`.";
      };

      useACMEHost = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "Use an existing `security.acme.certs.<name>` certificate (e.g. a wildcard) instead.";
      };

      openFirewall = mkOption {
        type = types.bool;
        default = false;
        description = "Open TCP ports 80 and 443 in the firewall.";
      };
    };

    podmanWrapper = mkOption {
      type = types.package;
      readOnly = true;
      default = podmanWrapper;
      description = "`openitcockpit-podman`: podman in the rootless context of the service user (read-only).";
    };
  };

  config = mkIf cfg.enable (mkMerge [
    {
      services.openitcockpit.environment = lib.mapAttrs (_: mkDefault) defaultEnvironment;

      services.openitcockpit.containers.postfix.environment.HOSTNAME = mkDefault (
        if cfg.nginx.enable then cfg.nginx.domain else config.networking.fqdnOrHostName
      );

      assertions = [
        {
          assertion = config.virtualisation.oci-containers.backend == "podman";
          message = "services.openitcockpit requires virtualisation.oci-containers.backend = \"podman\".";
        }
        {
          assertion = cfg.nginx.enable -> cfg.containers.openitcockpit.enable;
          message = "services.openitcockpit.nginx requires the openitcockpit container to be enabled.";
        }
        {
          assertion = builtins.all (c: !(hasInfix "\n" c)) custom.commands;
          message = "services.openitcockpit.customImage.commands must not contain newlines; use extraInstructions.";
        }
        {
          assertion = builtins.all (v: !(hasInfix "\n" v)) (builtins.attrValues finalEnvironment);
          message = "services.openitcockpit.environment values must not contain newlines.";
        }
      ];

      users.users.${cfg.user} = {
        isSystemUser = true;
        inherit (cfg) group uid;
        description = "openITCOCKPIT rootless containers";
        home = cfg.dataDir;
        createHome = true;
        homeMode = "750";
        # Keeps the user manager (and /run/user/<uid>) alive without a login.
        linger = true;
        autoSubUidGidRange = mkDefault true;
      };
      users.groups.${cfg.group} = { };

      environment.systemPackages = [ podmanWrapper ];

      virtualisation.podman.enable = true;

      virtualisation.oci-containers.containers = lib.mapAttrs' (
        name: i:
        let
          inherit (i) def opts service;
          isOitc = service == "openitcockpit";
          useCustom = isOitc && customEnabled;
          deps = builtins.filter (d: instances ? ${d}) (def.dependsOn or [ ]);
        in
        nameValuePair "${namePrefix}${name}" {
          image = if useCustom then customRef else imageRef opts;
          imageFile = if useCustom then null else opts.imageFile;
          pull = if useCustom || opts.imageFile != null then "never" else "missing";
          cmd = if opts.cmd != null then opts.cmd else def.cmd or [ ];
          hostname = i.inst.hostname or null;
          environment = (def.environment or { }) // opts.environment // (i.inst.environment or { });
          environmentFiles =
            optionals (def.envFile or false) ([ envFile ] ++ cfg.environmentFiles) ++ opts.environmentFiles;
          volumes = (def.volumes or [ ]) ++ opts.extraVolumes;
          ports = optional isOitc "${cfg.listen.address}:${toString cfg.listen.port}:443" ++ opts.ports;
          dependsOn = map (d: "${namePrefix}${d}") deps;
          networks = [ cfg.networkName ];
          # The upstream stack is made for Docker, which grants these by default
          # (podman does not). Needed e.g. by check_icmp and cron.
          capabilities = {
            NET_RAW = true;
            MKNOD = true;
            AUDIT_WRITE = true;
          };
          extraOptions = [
            "--network-alias=${name}"
          ]
          ++ map (a: "--network-alias=${a}") (def.aliases or [ ])
          ++ optional (def.init or false) "--init"
          ++ optional (def.nofile or false) "--ulimit=nofile=65536:65536"
          ++ opts.extraOptions;
          podman.user = cfg.user;
          autoStart = true;
        }
      ) instances;

      systemd.services = mkMerge [
        (lib.mapAttrs' (
          name: i:
          nameValuePair (unitName name) {
            after = [
              "${setupUnit}.service"
              "user@${uid}.service"
            ]
            ++ optional (pulledImages != [ ]) "${pullUnit}.service"
            ++ optional (i.service == "openitcockpit" && customEnabled) "${buildUnit}.service";
            # Only wanted: a failed pull falls back to the container's own pull
            # (and its Restart=), and restarting the pull unit (e.g. on switch)
            # must not restart the containers.
            wants = optional (pulledImages != [ ]) "${pullUnit}.service";
            requires = [
              "${setupUnit}.service"
              "user@${uid}.service"
            ]
            ++ optional (i.service == "openitcockpit" && customEnabled) "${buildUnit}.service";
            partOf = [ "openitcockpit.target" ];
            wantedBy = [ "openitcockpit.target" ];
          }
        ) instances)

        {
          ${setupUnit} = {
            description = "openITCOCKPIT podman network and volumes";
            after = [
              "user@${uid}.service"
              "linger-users.service"
            ];
            wants = [ "linger-users.service" ];
            requires = [ "user@${uid}.service" ];
            path = [ podman ];
            environment.HOME = cfg.dataDir;
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
              User = cfg.user;
              Group = cfg.group;
              WorkingDirectory = cfg.dataDir;
            };
            script = ''
              podman network exists ${escapeShellArg cfg.networkName} \
                || podman network create ${escapeShellArg cfg.networkName}
              for volume in ${escapeShellArgs namedVolumes}; do
                podman volume exists "$volume" || podman volume create "$volume" >/dev/null
              done
            '';
          };

          ${updateUnit} = {
            description = "Update openITCOCKPIT container images";
            after = [
              "network-online.target"
              "${setupUnit}.service"
            ];
            wants = [ "network-online.target" ];
            path = [
              podmanWrapper
              config.systemd.package
            ];
            serviceConfig = {
              Type = "oneshot";
              TimeoutStartSec = "2h";
            };
            script = updateScript;
          };
        }

        (mkIf (pulledImages != [ ]) {
          ${pullUnit} = {
            description = "Pull missing openITCOCKPIT container images";
            after = [
              "user@${uid}.service"
              "linger-users.service"
              "network-online.target"
            ];
            wants = [
              "linger-users.service"
              "network-online.target"
            ];
            requires = [ "user@${uid}.service" ];
            path = [ podman ];
            environment.HOME = cfg.dataDir;
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
              User = cfg.user;
              Group = cfg.group;
              WorkingDirectory = cfg.dataDir;
              TimeoutStartSec = "2h";
            };
            script = pullScript;
          };
        })

        (mkIf (customEnabled && instances ? openitcockpit) {
          ${buildUnit} = {
            description = "Build the customized openITCOCKPIT image";
            after = [
              "${setupUnit}.service"
              "network-online.target"
            ]
            ++ optional (pulledImages != [ ]) "${pullUnit}.service";
            wants = [ "network-online.target" ] ++ optional (pulledImages != [ ]) "${pullUnit}.service";
            requires = [ "${setupUnit}.service" ];
            path = [ podman ];
            environment.HOME = cfg.dataDir;
            serviceConfig = {
              Type = "oneshot";
              RemainAfterExit = true;
              User = cfg.user;
              Group = cfg.group;
              WorkingDirectory = cfg.dataDir;
              TimeoutStartSec = "1h";
              Restart = "on-failure";
              RestartSec = "1min";
            };
            script = ''
              ${optionalString (oitcOpts.imageFile != null) "podman load --input ${oitcOpts.imageFile}"}
              if podman image exists ${customRef}; then
                echo "${customRef} already exists"
              else
                podman build --pull=${basePull} --tag ${customRef} \
                  --file ${buildContext}/Containerfile ${buildContext}
              fi
              # Untag builds of previous configurations; pruned by the update job.
              podman images --noheading --format '{{.Repository}}:{{.Tag}}' \
                --filter reference=${customRepo} | while read -r ref; do
                  [ "$ref" = ${customRef} ] || podman untag "$ref" || true
                done
            '';
          };
        })
      ];

      systemd.targets.openitcockpit = {
        description = "openITCOCKPIT containers";
        wantedBy = [ "multi-user.target" ];
      };

      systemd.timers.${updateUnit} = mkIf cfg.autoUpdate.enable {
        wantedBy = [ "timers.target" ];
        timerConfig = {
          OnCalendar = cfg.autoUpdate.interval;
          RandomizedDelaySec = cfg.autoUpdate.randomizedDelaySec;
          Persistent = true;
        };
      };
    }

    (mkIf cfg.nginx.enable {
      services.nginx = {
        enable = true;
        virtualHosts.${cfg.nginx.domain} = {
          forceSSL = mkDefault true;
          inherit (cfg.nginx) enableACME useACMEHost;
          locations."/" = {
            # The container's nginx serves openITCOCKPIT on 443 only (port 80
            # redirects to https://$host), so we talk TLS to its self-signed
            # certificate over loopback.
            proxyPass =
              let
                host =
                  if
                    builtins.elem cfg.listen.address [
                      "0.0.0.0"
                      "::"
                      "[::]"
                    ]
                  then
                    "127.0.0.1"
                  else
                    cfg.listen.address;
              in
              "https://${host}:${toString cfg.listen.port}";
            proxyWebsockets = true;
            recommendedProxySettings = true;
            extraConfig = ''
              proxy_ssl_verify off;
              client_max_body_size 256M;
              proxy_read_timeout 300s;
              proxy_send_timeout 300s;
            '';
          };
        };
      };

      networking.firewall.allowedTCPPorts = mkIf cfg.nginx.openFirewall [
        80
        443
      ];
    })
  ]);
}
